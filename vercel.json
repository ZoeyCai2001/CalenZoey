{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "public/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index?__path=/" },
    { "source": "/:path*", "destination": "/api/index?__path=/:path*" }
  ]
}
