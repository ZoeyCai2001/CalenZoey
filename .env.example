# 存储：postgres 或 json（不设置且没有 PGHOST 时默认 json 文件存储）
STORAGE_DRIVER="postgres"
PGHOST="127.0.0.1"
PGPORT="5432"
PGDATABASE="playground"
PGUSER="playground"
PGPASSWORD="replace-with-your-postgres-password"
PGSCHEMA="calenzoey"
# 云端 Postgres（如 Neon）需要 SSL：
# PGSSLMODE="require"
# Vercel 推荐使用 Neon 控制台提供的 pooled connection string：
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# CALENZOEY_PUBLIC_URL="https://your-project.vercel.app"

# Kimi Coding（填其中一个即可；ANTHROPIC_* 只从 .env.local 读取）
KIMI_API_KEY="replace-with-your-kimi-api-key"
ANTHROPIC_BASE_URL="https://api.kimi.com/coding/"
ANTHROPIC_MODEL="kimi-for-coding"

# iPhone 快捷指令同步口令（设置后 apple-sync 请求必须带同名 token）
# CALENZOEY_SYNC_TOKEN="replace-with-a-random-token"

# 整站访问口令（部署到公网时务必设置；设置后浏览器需先登录）
# CALENZOEY_APP_TOKEN="replace-with-a-random-token"

# PORT="3000"
